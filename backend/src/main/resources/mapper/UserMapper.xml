<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novel.system.mapper.UserMapper">

    <select id="findByUsername" resultType="com.novel.system.entity.mysql.User">
        SELECT * FROM sys_user WHERE username = #{username} LIMIT 1
    </select>

    <select id="findByEmail" resultType="com.novel.system.entity.mysql.User">
        SELECT * FROM sys_user WHERE email = #{email} LIMIT 1
    </select>

</mapper>
