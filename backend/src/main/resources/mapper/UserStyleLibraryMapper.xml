<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novel.system.mapper.UserStyleLibraryMapper">

    <resultMap id="UserStyleLibraryResult" type="com.novel.system.entity.mysql.UserStyleLibrary">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="card_id" property="cardId"/>
        <result column="is_favorite" property="isFavorite"/>
        <result column="add_time" property="addTime"/>
    </resultMap>

    <select id="selectByUserId" resultMap="UserStyleLibraryResult">
        SELECT * FROM user_style_library
        WHERE user_id = #{userId}
        ORDER BY add_time DESC
    </select>

    <select id="selectByUserIdAndCardId" resultMap="UserStyleLibraryResult">
        SELECT * FROM user_style_library
        WHERE user_id = #{userId} AND card_id = #{cardId}
    </select>

    <delete id="deleteByUserIdAndCardId">
        DELETE FROM user_style_library
        WHERE user_id = #{userId} AND card_id = #{cardId}
    </delete>

</mapper>
