# ========================
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# ========================
# Java / Maven
# ========================
backend/target/
backend/*.class
backend/*.jar
backend/*.war
backend/.mvn/wrapper/maven-wrapper.jar

# ========================
# Node / Vue 前端
# ========================
frontend/node_modules/
frontend/dist/
